<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.broessl</groupId>
	<artifactId>treesql-parent</artifactId>
	<version>${treesql.version}</version>
	<packaging>pom</packaging>
	<modules>
		<module>treesql-core</module>
		<module>treesql-csv</module>
		<module>treesql-file</module>
		<module>treesql-cli</module>
		<module>treesql-yaml</module>
		<module>treesql-xml</module>
		<module>treesql-swing-gui</module>
	</modules>
	<properties>
		<treesql.version>0.0.1-SNAPSHOT</treesql.version>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.source>21</maven.compiler.source>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<antlr-version>4.13.2</antlr-version>
		<jackson.version>2.19.0</jackson.version>
		<native.maven.plugin.version>0.10.6</native.maven.plugin.version>
	</properties>
	<name>TreeSQL</name>
	<description>A SQL-like query language for tree-structured data</description>
	<url>https://github.com/broessl/treesql</url>
	<inceptionYear>2025</inceptionYear>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>broessl</id>
			<name>Bastian Roessl</name>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:git://github.com/broessl/treesql.git</connection>
		<developerConnection>scm:git:ssh://github.com:broessl/treesql.git</developerConnection>
		<url>https://github.com/broessl/treesql/tree/main</url>
	</scm>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-runtime</artifactId>
				<version>${antlr-version}</version>
			</dependency>
			<dependency>
				<!-- v0.0.1 introduces old antlr4 runtime-->
				<groupId>de.vandermeer</groupId>
				<artifactId>skb-interfaces</artifactId>
				<version>0.0.2</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vandermeer</groupId>
				<artifactId>asciitable</artifactId>
				<version>0.3.2</version>
				<exclusions>
					<exclusion>
						<groupId>org.antlr</groupId>
						<artifactId>antlr4-runtime</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<dependency>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-runtime</artifactId>
			</dependency>
			<!-- TEST DEPENDENCIES -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>5.11.4</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-params</artifactId>
				<version>5.11.4</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<plugins>
			<plugin>
				<groupId>com.spotify.fmt</groupId>
				<artifactId>fmt-maven-plugin</artifactId>
				<version>2.27</version>
				<executions>
					<execution>
						<!-- if validation fails, use: mvn com.spotify.fmt:fmt-maven-plugin:format -->
						<?m2e execute onConfiguration?>
						<phase>validate</phase>
						<goals>
							<goal>format</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.4.0</version>
				<executions>
					<execution>
						<id>aggregate-add-third-party</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>aggregate-add-third-party</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.basedir}</outputDirectory>
							<thirdPartyFilename>LICENSES_THIRD_PARTY.txt</thirdPartyFilename>
							<includeTransitiveDependencies>true</includeTransitiveDependencies>
							<excludeTransitiveDependencies>false</excludeTransitiveDependencies>
							<cleanLicensesOutputDirectory>false</cleanLicensesOutputDirectory>
							<excludeScopes>test</excludeScopes>
							<excludeGroupIds>io.broessl</excludeGroupIds>
							<licenseMerges>
								<licenseMerge>Apache License 2.0|Apache 2.0|Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0</licenseMerge>
								<licenseMerge>BSD 3-Clause|BSD License 3|BSD-3-Clause|The BSD 3-Clause License|BSD licence</licenseMerge>
								<licenseMerge>MIT License|MIT|The MIT License</licenseMerge>
							</licenseMerges>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>